{
  "scripts": {
    "api": "node --env-file=.env server.js",
    "test": "node --require tsx/cjs ./node_modules/mocha/bin/mocha.js \"tests/**/*.test.js\"",
    "typecheck": "tsc --allowJs --checkJs --noEmit --target es2022 --module commonjs --types node src/borrowingCalculator.ts",
    "coverage": "c8 --all --include=src/borrowingCalculator.ts --reporter=text --reporter=lcov node --require tsx/cjs ./node_modules/mocha/bin/mocha.js \"tests/**/*.test.js\"",
    "start": "node --disable-warning=ExperimentalWarning --env-file=.env src/borrowingCalculator.ts"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "c8": "^12.0.0",
    "mocha": "^11.7.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
